rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string
    //   - email: string (required)
    //   - role: string (required, ['admin', 'staff'])
    //   - createdAt: timestamp
    //
    // Collection: vehicles
    // Document ID: {vehicleId}
    // Fields:
    //   - plateNumber: string (required)
    //   - model: string (required)
    //   - type: string
    //   - status: string (required, ['available', 'maintenance', 'in-use'])
    //   - imageUrl: string
    //
    // Collection: bookings
    // Document ID: {bookingId}
    // Fields:
    //   - userId: string (required)
    //   - userName: string
    //   - vehicleId: string (required)
    //   - vehicleName: string
    //   - driverId: string
    //   - driverName: string
    //   - startTime: timestamp (required)
    //   - endTime: timestamp (required)
    //   - purpose: string (required)
    //   - destination: string (required)
    //   - passengers: string
    //   - status: string (required, ['pending', 'approved', 'rejected', 'cancelled', 'completed'])
    //   - createdAt: timestamp
    //   - updatedAt: timestamp
    //   - adminComment: string
    //
    // ===============================================================

    // Collection: drivers
    // Document ID: {driverId}
    // Fields:
    //   - name: string (required)
    //   - phone: string
    //   - status: string (required, ['available', 'unavailable', 'on-duty'])
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "nanthawudnoi@gmail.com" && request.auth.token.email_verified == true));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'role', 'displayName', 'createdAt']) &&
             data.role in ['admin', 'staff'] &&
             data.email is string && data.email.size() < 100 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100));
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['plateNumber', 'model', 'status']) &&
             data.keys().hasOnly(['plateNumber', 'model', 'status', 'type', 'imageUrl']) &&
             data.status in ['available', 'maintenance', 'in-use'] &&
             data.plateNumber is string && data.plateNumber.size() < 20 &&
             data.model is string && data.model.size() < 100;
    }

    function isValidDriver(data) {
      return data.keys().hasAll(['name', 'status']) &&
             data.keys().hasOnly(['name', 'phone', 'status']) &&
             data.status in ['available', 'unavailable', 'on-duty'] &&
             data.name is string && data.name.size() < 100;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'vehicleId', 'startTime', 'endTime', 'purpose', 'destination', 'status']) &&
             data.keys().hasOnly(['userId', 'userName', 'userEmail', 'vehicleId', 'vehicleName', 'driverId', 'driverName', 'startTime', 'endTime', 'purpose', 'destination', 'passengers', 'requesterName', 'status', 'createdAt', 'adminComment', 'cancellationReason', 'cancelledAt', 'cancelledBy', 'updatedAt']) &&
             data.status in ['pending', 'approved', 'rejected', 'cancelled', 'completed'] &&
             data.startTime is timestamp &&
             data.endTime is timestamp &&
             data.purpose is string && data.purpose.size() < 500 &&
             data.destination is string && data.destination.size() < 200 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() < 100)) &&
             (!('passengers' in data) || (data.passengers is string && data.passengers.size() < 500)) &&
             (!('requesterName' in data) || (data.requesterName is string && data.requesterName.size() < 100)) &&
             (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() < 1000)) &&
             (!('adminComment' in data) || (data.adminComment is string && data.adminComment.size() < 1000)) &&
             (!('cancelledBy' in data) || (data.cancelledBy is string && data.cancelledBy.size() < 100));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isOwner(userId) && isValidUser(request.resource.data) && 
         (request.resource.data.role == 'staff' || request.resource.data.email == "nanthawudnoi@gmail.com"))
      );
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && isValidUser(request.resource.data));
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidVehicle(request.resource.data);
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidDriver(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidBooking(request.resource.data);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && (resource.data.status == 'pending' || request.resource.data.status == 'cancelled') && isValidBooking(request.resource.data));
      allow delete: if isAdmin();
    }
  }
}
